# clangd configuration. Routes each file to the compile database of the build
# that actually compiles it, by path, so clangd / pi-lens resolve the right
# includes per file type:
#
#   tests/                                  -> build/test/     (host compiler)
#   firmware/ lib/ bootloader/              -> build/release/  (Arm cross-build)
#
# Generate the DBs once: `make test` for tests/, `make firmware` for the cross-
# build. A file whose DB hasn't been generated yet falls through to clangd's
# defaults (no compile flags) — that's expected on a fresh clone.
#
# --- tests/ (host compiler + GoogleTest) -----------------------------------
# tests/ is a standalone CMake project built with the HOST compiler and linked
# against GoogleTest, which is fetched via FetchContent at configure time. Its
# include paths (gtest/gtest.h, etc.) only exist in build/test/compile_commands.json
# AFTER `cmake -B build/test -S tests` has run. Without this block, clangd/pur-lens
# can't resolve those headers and reports a spurious "file not found".
If:
  PathMatch: ^tests/.*\.(cpp|cc|cxx|hpp|h)$
CompileFlags:
  CompilationDatabase: build/test

# Firmware / bootloader / lib: built with the Arm cross-toolchain. Their
# compile_commands.json lands in build/release/ once `make` (or `make firmware`)
# has configured the cross-build. Without this block clangd / pi-lens can't
# resolve the STM32 HAL / CMSIS includes on firmware files.
#
# Add: supplies the include paths for STANDALONE HEADER analysis. clangd maps
# .cpp TUs through the DB but cannot map a .h analyzed on its own to a cross-TU
# entry — Sequencer.h dispatched directly got "RingBuffer.h not found" even
# with the DB present. For DB-routed .cpp files these -I flags are harmless
# duplicates of the compile command.
If:
  PathMatch: ^(firmware|lib|bootloader)/.*\.(cpp|c|cc|cxx|hpp|h|s|S)$
CompileFlags:
  CompilationDatabase: build/release
  Add:
    - -Ilib/Inc
    - -Ifirmware/Inc
    - -Ifirmware/Src
    - -Ifirmware/Src/filesystem
    - -Ifirmware/Src/hardware
    - -Ifirmware/Src/midi
    - -Ifirmware/Src/MidiController
    - -Ifirmware/Src/midipal
    - -Ifirmware/Src/SimpleEffect
    - -Ifirmware/Src/synth
    - -Ifirmware/Src/utils
    - -Ifirmware/Drivers/CMSIS/Include
    - -Ifirmware/Drivers/CMSIS/Device/ST/STM32H7xx/Include
    - -Ifirmware/Drivers/STM32H7xx_HAL_Driver/Inc
    - -Ifirmware/Drivers/STM32H7xx_HAL_Driver/Inc/Legacy
    - -Ifirmware/Middlewares/ST/STM32_USB_Device_Library/Core/Inc
    - -Ifirmware/Middlewares/ST/STM32_USB_Device_Library/Class/MIDI/Inc
    - -Ifirmware/Middlewares/ST/STM32_USB_Device_Library/Class/AUDIO/Inc
